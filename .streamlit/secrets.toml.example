# Metan.iQ — Streamlit secrets template
# Copia in `secrets.toml` (mai committarlo!) e popolalo coi tuoi valori.
# Su Streamlit Cloud: Manage app → Settings → Secrets, incolla il contenuto.

# Sentry error tracking (Fase 1.6) — opzionale ma raccomandato
# Crea progetto gratuito su https://sentry.io e copia DSN
[sentry]
dsn = ""
environment = "production"      # "production" | "staging" | "development"
traces_sample_rate = 0.1        # 10% delle transazioni tracciate (perf monitoring)

# Stripe billing (Fase 2.3)
[stripe]
secret_key = "sk_test_xxx"
publishable_key = "pk_test_xxx"
webhook_secret = "whsec_xxx"
price_pro_monthly = "price_xxx"
price_enterprise_monthly = "price_xxx"

# Auth / JWT (Fase 2.1)
[auth]
jwt_secret = "change-me-to-a-random-long-string"
cookie_name = "metaniq_session"
cookie_expiry_days = 30

# DB Postgres (Fase 2.1) — Supabase / Neon
[database]
url = "postgresql://user:password@host:5432/dbname"

# SMTP per email transactional (signup confirm, password reset)
[smtp]
host = "smtp.gmail.com"
port = 587
user = "noreply@metaniq.it"
password = ""
from_address = "Metan.iQ <noreply@metaniq.it>"
